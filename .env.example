# Local configuration for chora-a2a-gateway.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_a2a
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_a2a?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_a2a?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-a2a-gateway-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-a2a-gateway

# Repo backend: unset|pg (durable, requires the pool) | inmem (dev only).
CHORA_A2A_REPO_BACKEND=
CHORA_A2A_REPO_TENANT_ID=

# Federated closure-saga subscriber.
CHORA_CLOSURE_SUBSCRIPTION=chora-a2a-gateway.closure-pseudonymise
CHORA_PII_CLOSURE_MAP_PATH=config/PII_Closure_Map.yaml

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Durability guard: report (default) | enforce.
CHORA_DURABILITY_GUARD=report
